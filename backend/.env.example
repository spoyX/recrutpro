# Copy to .env and adjust. Compose falls back to these same defaults if
# no .env exists, so local `docker compose up` works without this file.

NODE_ENV=production

# MongoDB credentials — used to build MONGO_URI in docker-compose.yml
MONGO_USER=recrutpro
MONGO_PASSWORD=recrutpro
MONGO_DB=recrutpro

# Only needed when running the API outside Docker (npm run dev). Inside
# compose, MONGO_URI is assembled from the three values above and points at
# the mongo service instead of localhost.
MONGO_URI=mongodb://recrutpro:recrutpro@localhost:27017/recrutpro?authSource=admin

# Session signing secret (FR-2 / D-001, session-based auth — not JWT).
# The compose default is a placeholder. Replace with a long random value
# before any non-local deployment.
SESSION_SECRET=dev-only-change-me

# D-111 - the session cookie's Secure attribute.
#
# `secure` defaults to ON under NODE_ENV=production, which this file sets. The
# LOCAL stack serves plain HTTP through nginx on :4200, and a Secure cookie is
# never sent back over HTTP - so leaving the default here would break login
# locally: the POST /auth/login returns 200, the browser declines to store the
# cookie, and the next request arrives anonymous.
#
# *** REMOVE THIS LINE (or set it to true) FOR ANY REAL TLS DEPLOYMENT. ***
# That is the whole point of pre-demo checklist item A3.
COOKIE_SECURE=false


# Cloudinary — resume storage (FR-21 to FR-23, D-040).
# REQUIRED for the CV routes; without all three they return 503 and the rest
# of the API still runs. There is NO default: unlike MONGO_URI these are real
# credentials, so nothing is inlined in docker-compose.yml and nothing is
# committed. Copy this file to .env (already gitignored) and fill them in.
# The API secret must never be logged, echoed in a response, or hardcoded.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
