# Copy to .env and adjust. Compose falls back to these same defaults if
# no .env exists, so local `docker compose up` works without this file.

NODE_ENV=production

# MongoDB credentials — used to build MONGO_URI in docker-compose.yml
MONGO_USER=recrutpro
MONGO_PASSWORD=recrutpro
MONGO_DB=recrutpro

# Only needed when running the API outside Docker (npm run dev). Inside
# compose, MONGO_URI is assembled from the three values above and points at
# the mongo service instead of localhost.
MONGO_URI=mongodb://recrutpro:recrutpro@localhost:27017/recrutpro?authSource=admin

# Session signing secret (FR-2 / D-001, session-based auth — not JWT).
# The compose default is a placeholder. Replace with a long random value
# before any non-local deployment.
SESSION_SECRET=dev-only-change-me
